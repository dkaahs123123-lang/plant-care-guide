hoto/pthgogan/&imageFileName=842c354d06b2ab9daf379a581fe075d8170210d9e3e5a4b435aff899d09110d937de2095457f99a3a38506b2c75b6cc3","분생포자2"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/pthgogan/&imageFileName=db6f4312c2c7be94d76fa0c54230ebcb7008aa46de1a6520fe2d971407e11174d42113d50282cbce172783baef17b44d","분생포자3"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/pthgogan/&imageFileName=cbdcbb5c789e0aaad765888b07c043856211337bddd82207337da0db256c4e9d4c6c3e889e64d4332d7feec8673bc11d","분생포자4"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/pthgogan/&imageFileName=1cc1b3e84ba470786dcc2d473d25b38598a56a29250f30023bd5b379b36786d35e0be9c932359053413bc20f882584d8","분생포자경1"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/pthgogan/&imageFileName=1cc1b3e84ba470786dcc2d473d25b385ffd0e9395e4d52385302e987a819d56a174c0f6b1100c465a01653b20819f4b7","분생포자경2"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/pthgogan/&imageFileName=b1aa97814c94e09b1ef266556b9311c28e232b7d5ca6c12f191dc2c4bb65a627e1d2ee1d8e08a26d7f659befd6ae6277fb2e30c26e42ff181b80f8099c4e56f2","잎마름병원"]],7]]}],"insects":[{"crop":"산마늘","name":"도둑나방","sci":"Mamestra brassicae","family":"밤나방과","damage":"어린유충은 잎맥만 남기고 먹으며 결구되는 채소의 경우 식물 속으로 파고들어 가해를 하고 잡식성이어서 채소, 화훼 등 여러 작물에 피해를 준다.","form":"도둑나방 성충의 날개를 편 길이는 40~47㎜이고 전체가 회갈색~흑갈색이고 앞날개에 흰색，갈색，검은색의 인편이 산재하고，콩팥 무늬 부위에 백색 반점이 있다. 어린 유충은 녹색을 띠나 다 자라면 황갈색 바탕에 지저분한검은 무늬가 생기고 몸색의 변이가 심하다. 노숙유충은 크기가 약 40㎜이고，머리 부분은 담록색 내지 황갈색으로 선명하지 않은 암갈색의 망상무늬가 있다. 몸은 회흑색 바탕에 암갈색과 암록색 흑점이 많이 있으나 개체에 따라서차이가 많으며，계절적으로 봄，여름에는 암갈색，가을에는 회흑색인 개체가많다.","ecology":"번데기로 월동하고 1회 성충은 4-6월, 2회 성충은 8-9월에 발생하고 유충기간은 40-45일이다.\n성충은 해질 무렵부터 활동하여 낮에는 마른 잎 사이에 숨는다.\n유충은 낮에는 땅속에 숨어 있다가 밤에 나와 활동한다.\n유충은 어릴 때는 집단으로 활동하나 크면 분산한다.","prevention":"","chemical":"","biology":"나방류 해충 방제에 활용이 가능한 유기농업자재는 식물추출물인 고삼, 님, 멀구슬, 데리스, 제충국, 은행(잎, 열매) 등과 곤충병원성미생물인 비티(Bacillus thuringiensis), 곤충병원성선충(Steinernema capocapsae) 등이 있다.\n이 허용물질들은 산마늘의 도둑나방을 대상으로 시험된 바는 없으나 파밤나방, 담배거세미나방, 배추좀나방, 옥수수 들명나방 등 나방류 해충에 살충효과가 있는 것으로 알려져 있다.\n식물추출물은 고농도에서 약해를 유발할 수 있으며, 곤충병원성미생물은 화학약제에 비해 효과의 발현이 늦고 방제효과가 낮은 단점이 있으므로 이에 유의해야 한다.\n또한 곤충병원성선충은 살아있는 생물이므로 예방 차원의 살포가 아닌 어린 나비목 해충의 유충이 발생되었을 때 살포하여야 하며 햇빛의 자외선, 35℃ 이상의 고온 및 건조한 환경에 매우 약하므로 해가 진 직후에 살포해야 효과를 높일 수 있다.","distrib":"","photos":[["피해 사진",[["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=5adc293b80b8e339220bcca6e22dba706abc05271142511d0aae9b09030ea2968cefb96526007c09ce84fc252792061b","잎가해 피해 흔(잎)"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=c6f2ea4d6c1a0b7ca23b3afeed0b0dfb5a92853d0fa7d51c829f64412b395cfd91dbced43da4340d065540a8e241bc27bf94ad6cbd5ab54060e53e8bf80b03310840866796c49402104cd4000ee69f1536cc79799e3cc469838e47888080254b","도둑나방"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=43f7da23a357cc27aaeb2fb6205fbbc6fb7e861b96552b8caa1883719fc0bce7084c20c4fd82a8bbefbdcea152ef79e0ea22a5ba218ec641b0a1ed7e982800c9e9b145fd90618c264dfa7c2e63aa3d3db92e61c9ef0df45dd6e363f23b86baa2","도둑나방"]],3],["해충 사진",[["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/spcs/&imageFileName=05049f8a09d6f3cdeb6fb0c51e441581452b018d6a9a23228a64fc46ef6ba5817a62e495bdb0f49fcaacd64cdfd4183a","유충 · 도둑나방 유충"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/spcs/&imageFileName=3cc3c59d1610421603e13f801f4f4c74452b018d6a9a23228a64fc46ef6ba5817a62e495bdb0f49fcaacd64cdfd4183a","번데기 · 도둑나방 번데기"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/spcs/&imageFileName=21c4a575ad2b249740d2b4e9ad87033d452b018d6a9a23228a64fc46ef6ba5817a62e495bdb0f49fcaacd64cdfd4183a","알 · 도둑나방 알"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/spcs/&imageFileName=d6cb152cc868c294075281635723c557452b018d6a9a23228a64fc46ef6ba5817a62e495bdb0f49fcaacd64cdfd4183a","유충 · 도둑나방 유충(담배)"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/spcs/&imageFileName=9a15bff2d82fb88c0800b02f34ae9ef5452b018d6a9a23228a64fc46ef6ba5817a62e495bdb0f49fcaacd64cdfd4183a","유충 · 도둑나방 유충(담배)"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/spcs/&imageFileName=0cd591da3c191803639e996a87c33922c239e852b07299a7b4841086c9cb47f9bada25a0b0147ee89e667919f22ef20a7facc6063a77b0a3395279e7b7096342","유충 · 도둑나방 유충(담배)"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/spcs/&imageFileName=0cd591da3c191803639e996a87c339228b0d99465756ec3c57934b3d38049fba3ddeb6bcc753c67a70555e2a80e876687a62e495bdb0f49fcaacd64cdfd4183a","유충 · 도둑나방 유충(담배)-1"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/spcs/&imageFileName=02d6a956ce18d5d433722e77ac32b659356c0392efee08c51f7728b155d7837b3faf4b770ee3b7d3dce920ff12e2fe9308628f5e192f87761950f27a1e3ddd9a","유충 · 도둑나방 노숙 유충"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/spcs/&imageFileName=577e9df955501170a27386df7f0fcf493ca2094ce1b0ee03641c6d3d346f742727e4aa362f230ba92f038eafd05543767708bdd910e30c32b05b692b1d66822efe234dbb9b0b97e48b03b12ae0114e5d","유충 · 도둑나방 알에서 부화한 유충"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/spcs/&imageFileName=e46170a199c296e876f30dff7c3969f333cae8759b564f2e83f4c1e4a26195a96674b88777ddfd385907bf80c6f527c002c32c9a2b851aaac9a28c4e2ec07211","유충 · 도둑나방 어린 유충"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/spcs/&imageFileName=0cd591da3c191803639e996a87c339226ea7a2e9e087d5ccda41b98db1890a861dc76fa02323ed78767bd87158bb360f","유충 · 도둑나방 유충"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/spcs/&imageFileName=39b37090308cef54a2cc38a3ac523bd76ea7a2e9e087d5ccda41b98db1890a865ca4a456d7b786f8d3ae2a11fcc2b4c4","성충 · 도둑나방 성충"]],19]]},{"crop":"산마늘","name":"좀남색잎벌레","sci":"Gastrophysa atrocyanea","family":"잎벌레과","damage":"유충의 무리가 잎을 갉아먹으며 피해를 주고 땅속에서 번데기가 되고 소리쟁이류, 수영 등 초본류를 가해한다.","form":"몸길이 5~6mm 정도의 소형 잎벌레이다. 몸은 전체적으로 긴 타원형 모양이고 푸른빛을 띠는 검은색이며 등쪽은 광택이 있는 남색을 띤다. 몸의 등쪽으로는 세로줄 모양의 점각 무늬가 많이 나 있다. 가운뎃다리와 뒷다리의 종아리마디는 바깥쪽으로 튀어나와 있다.","ecology":"알·애벌레·번데기·어른벌레를 거치는 갖춘탈바꿈을 하며, 어른벌레로 겨울나기를 한다.\n겨울나기가 끝난 어른벌레는 이듬해 4월~5월경에 깨어나서 소리쟁이·수영·여뀌 등의 잎을 먹는다.\n애벌레는 무리를 지어서 생활하는 군서생활을 하며 번데기가 되기 직전에 땅속으로 들어간다.\n한국·중국·일본·타이완·동남아시아·인도 등지에 분포한다.","prevention":"","chemical":"","biology":"잎벌레류 예찰용으로 황색점착트랩을 활용할 수 있다.\n잎벌레류 방제에 사용이 가능한 유기농업자재는 식물추출물인 고삼과 미생물인 곤충병원성 선충(Steinernema capocapsae) 등이 있다.\n고삼과 곤충병원성선충의 좀남색잎벌레에 대한 살충력은 시험된 바 없으나, 배추벼룩잎벌레에 살충효과가 있는 것으로 알려져 있다.\n식물추출물은 고농도에서 약해를 유발할 수 있으며, 곤충병원성 선충은 화학약제에 비해 효과의 발현이 늦고 방제효과가 낮은 단점이 있으므로 이에 유의해야 한다.\n또한 곤충병원성 선충은 살아있는 생물이므로 예방 차원의 살포가 아닌 잎벌레가 발생되었을 때 살포하여야 하며, 햇빛의 자외선, 35℃ 이상의 고온 및 건조한 환경에 매우 약하므로 해가 진 직후에 살포해야 효과를 높일 수 있다.","distrib":"","photos":[["피해 사진",[["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=5adc293b80b8e339220bcca6e22dba706abc05271142511d0aae9b09030ea2964a21f7a797cfb470923745f9238f344c","잎가해 피해 흔(잎) · 피해정보"]],1],["해충 사진",[["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/spcs/&imageFileName=1257511e6532e0ce5ee2a0fcf360e00d815895fc3478d542a61fb100b4c154ec4d120d60afb3696ada9ae72ad344298c02c32c9a2b851aaac9a28c4e2ec07211","유충 · 좀남색잎벌레 유충"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/spcs/&imageFileName=1257511e6532e0ce5ee2a0fcf360e00de32210c160e9b125e1552bf1a0e494475eb8c377902e3e9d05829835c1d982f602c32c9a2b851aaac9a28c4e2ec07211","유충 · 좀남색잎벌레 유충"]],2]]}]},"mapping":"‘산마늘’ → Allium microdictyon. 작물명과 학명은 이 사이트에서 연결했고, 학명은 WFO 목록으로 확인했습니다.","uses":{"crop":{"kinds":["채소"],"crops":["산마늘"],"source":"농촌진흥청 국가농작물병해충관리시스템(NCPMS)","url":"https://ncpms.rda.go.kr"},"mfds":{"items":[{"name":"산마늘","other":"명이나물, Wild garlic, Alpine broad-leaf allium","sci":"Allium victorialis L. / Allium microdictyon Prokh.","edible":"가능","parts":"뿌리, 잎","cond":"","herbal":"","exact":true}],"source":"식품의약품안전처 수입식품 원료정보 (공공데이터포털)","url":"https://www.data.go.kr/data/15111777/openapi.do","retrieved":"2026-11-08"}}}