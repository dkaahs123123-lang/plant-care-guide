y=/photo/pthgogan/&imageFileName=1cc1b3e84ba470786dcc2d473d25b38557b5277fcca43e5a1ee9c6046db8c831a3c2e232df7fb06b21dd01d7455181ae","분생포자경3"]],11]]}],"insects":[]},"mapping":"‘백작약’ → Paeonia lactiflora; ‘작약’ → Paeonia lactiflora. 작물명과 학명은 이 사이트에서 연결했고, 학명은 WFO 목록으로 확인했습니다.","kfs":{"source":"산림청 표준식물종정보 (공공데이터포털)","url":"https://www.data.go.kr/data/15092915/fileData.do","basis":"2021-10-20","items":[{"name":"참작약","sci":"Paeonia lactiflora var. trichocarpa (Bunge) Stern","family":"작약과","bloom":"5","fruit":"6","protected":true,"endemic":false,"size":"높이 50-80cm"}]},"uses":{"mfds":{"items":[{"name":"작약","other":"백작약, 참작약, Peony Root","sci":"Paeonia lactiflora Pallas / Paeonia albiflora Pallas var. trichocarpa Bunge / Paeonia japonica var. pilosa NAKAI 또는 동속근연식물","edible":"제한","parts":"뿌리※ (작약)","cond":"","herbal":"","exact":true}],"source":"식품의약품안전처 수입식품 원료정보 (공공데이터포털)","url":"https://www.data.go.kr/data/15111777/openapi.do","retrieved":"2026-11-03"},"herb":{"items":[{"no":"204921","name":"작약","sci":"Paeonia lactiflora (작약과)","herbal":"芍藥(작약)","part":"작약 및 동속식물의 뿌리","form":"□ 다년초로서 키 50∼80cm로서 뿌리가 방추형이고 굵고 자르면 붉은 빛이 돈다. 근생엽은 1∼2회 우 상으로 갈라지며 윗부분의 것은 3개로 깊게 갈라지기도 하고 밑부분이 엽병으로 흐른다. 꽃은 백색, 적색 등 여러 품종이 있으며 원줄기 끝에 큰 꽃이 1개씩 달리고 수술은 많으며 황색이다.\n□ 개화기 : 5∼6월\n□ 분포 및 환경 : 양지바르고 토심이 깊고 배수가 잘되는 곳. 관상용 화초와 약용으로 재배\n□ 수확·건조 : 9~10월 수확하여 양건한다.","folk":"□ 눈병 치료 - 작약 뿌리, 당귀 뿌리, 깽깽이풀 뿌리를 같은 양으로 섞은 다음 적당한 양의 물을 넣고 달이면서 나 오는 김을 환부에 쏘이고, 달여낸 약물로 눈을 자주 씻는다.\n- 참고 :\n1) 감초와 같이 다려서 복용하면 위장내의 염증을 제거시키고 통증을 완화시킨다.\n2) 간기능 활성화로 간보호작용이 현저하다.\n3) 근육경련 증상을 완화시키므로 항경련 제로 많이 응용된다.","img":"https://www.nongsaro.go.kr/cms_contents/1124/204921_MF_REPR_ATTACH_01.jpg"}],"source":"농촌진흥청 농사로 약초정보(민간약초)","license":"공공누리 제3유형 (출처표시, 변경금지)","url":"https://www.nongsaro.go.kr/portal/ps/psn/psnj/openApiLst.ps?menuId=PS65428","retrieved":"2026-11-07"}}}