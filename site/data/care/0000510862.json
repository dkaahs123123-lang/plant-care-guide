an/&imageFileName=1cc1b3e84ba470786dcc2d473d25b38563b91f9e7ebbe98da432f991aa993ada838f026ee786269fbea979145cefc38416581f226a0c273fd0590d0d2461fc24","분생포자경 및 분생포자2"]],9]]},{"crop":"오크라","name":"흰가루병","eng":"Powdery Mildew","symptoms":"병징은 잎의 앞뒷면에서 나타나며, 원형 또는 부정형 흰색병반으로 밀가루를 뿌린 모양으로 형성된다.\n병해로 인해 생육저하 및 노하를 유발한다.","condition":"","prevention":"","chemical":"","biology":"","pathogen":"","photos":[["증상 사진",[["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=d964c6cc08153cf176b59bd789f351b2f7f999c23b7625198099303672b6c2696d049319a462d87d12fcb28d9440e618","병징1(잎) · 병증상"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=2ddf7f155a198462ee70c0cfd8386e04195823bb0692cc50c9c601c6a46d970f6d049319a462d87d12fcb28d9440e618","병징2(잎) · 병증상"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=013ef5ef3b9bd8a6ff5ef9e38210a5fdbb188254555428df14e9d016bb529aa86d049319a462d87d12fcb28d9440e618","병징3(잎) · 병증상"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=e6a06653f47d1e76391a14b0d921b6cb53de9ecefe1894bd3e8a3d58d394d31a6d049319a462d87d12fcb28d9440e618","병징4(잎) · 병증상"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=0b6db0f3c4d1bed0d1df54df0f6a633496f728e2052922312008bb74048c8b546d049319a462d87d12fcb28d9440e618","병징5(잎) · 병증상"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=d7d78e25cf3596d345d95a212e024a62fed4d79ea62052b0d294fe97c6e78a996d049319a462d87d12fcb28d9440e618","병징6(잎) · 병증상"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=73839f7681fd9ac831a6689a68a21f6bc8eb636d4cae5153a48271079eae5c366d049319a462d87d12fcb28d9440e618","병징7(잎) · 병증상"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=a401e94d2720113b6664ee41b205797110abafc94c5125ebb05a27143fde20516d049319a462d87d12fcb28d9440e618","병징8(잎) · 병증상"]],8]]}],"insects":[]},"mapping":"‘오크라’ → Abelmoschus esculentus. 작물명과 학명은 이 사이트에서 연결했고, 학명은 WFO 목록으로 확인했습니다.","web":{"source":"NC State Extension Gardener Plant Toolbox (미국 노스캐롤라이나 주립대)","retrieved":"2026-11-08","name":"Abelmoschus esculentus","url":"https://plants.ces.ncsu.edu/plants/abelmoschus-esculentus/","facts":[["빛","햇빛 많이 (직사광선 하루 6시간 이상)"],["흙의 물 빠짐","물이 잘 빠지는 흙"],["알맞은 흙","점토(찰흙)"],["흙의 산도","중성 (pH 6.0~8.0)"],["관리 난이도","보통"],["자라는 속도","보통"],["한해·여러해살이","한해살이"],["번식 방법","씨앗"],["겨울나기","한해살이라 겨울 전에 한살이를 마칩니다"],["다 자란 높이","약 0.9~1.5m"],["심을 자리 폭","약 30cm~0.9m"]],"notes":[["주의할 점","피부에 닿으면 염증"],["원산지","열대 아프리카, 아시아"],["잘 생기는 해충","진딧물"]],"zone":null,"zoneC":null},"cases":{"source":"농촌진흥청 농사로 현장기술지원 사례","url":"https://www.nongsaro.go.kr/portal/ps/psz/psza/contentSub.ps?menuId=PS00077&cntntsNo=","license":"공공누리 제4유형 (출처표시, 상업적 이용금지, 변경금지)","retrieved":"2026-11-08","items":[{"no":"269209","title":"아열대채소(오크라) 재배 현장 기술지원","crop":"오크라","region":"충청남도 당진시","date":"2026-07-23","sections":[["농가 및 현장 의견",["오크라 정식 후 고사주 발생원인 및 이상주 발생에 대한 종합적인 현장 기술지원 요청"]],["현장 조사 결과",["2026년 4월 5일 시설하우스와 노지에 정식하였는데 지제부 쪽의 줄기가 갈변되면서 잎이 마르고 고사하는 현상으로 재파종한 곳이 많았음","하우스에 진딧물 발생으로 전체적으로 생육이 부진한 상태임","인근 농가 오크라 하우스에 꽃노랑총채벌레가 많아 토마토반점위조바이러스에 의한 피해로 인하여 생육과 착과가 불량한 것으로 보임","논에 비닐하우스를 설치하여 5년차 오크라를 재배하고 있는 포장은 하우스 측창 양쪽 두둑의 오크라는 생장이 매우 나쁘고 중앙 쪽 두둑은 생육이 양호함","피해 정도에 따라 토양 수분함량과 전기전도도(EC)를 간이 측정한 결과 피해가 심한 측창 쪽은 각각 45.1∼49.7%, 0.64∼0.67 dS/m이었고, 중앙 쪽은 각각 37.2∼46.2%, 1.15∼1.27 dS/m이었음","비닐하우스 8개 동(2,112㎡)의 오크라는 정도의 차이는 있으나 모든 하우스에서 정식 후 어린 식물체가 부분적으로 시들어 죽는 현상이 발생하여 다시 심어 보식했으나 전체적으로 생육이 불량한 것이 많음","시드는 식물체는 뿌리 부분이 검게 변색되고 생장이 멈춘 상태임"]],["종합 검토의견",["비닐하우스 8개 동의 오크라 생장 이상은 토양 병해인 시들음병이 발생한 것으로 판단되고, 잎에 이상 증상 발생과 착과 불량은 토마토반점위조바이러스에 의한 피해로 보임","논에 설치한 비닐하우스의 오크라 생장 불량은 하우스 주변의 물 빠짐이 불량하여 강우 시 빗물이 하우스 측면으로 스며들어 과습에 의한 피해로 판단됨"]],["기술지도 방향",["오크라 직파하기 전 종자를 18시간 침지처리를 거칠 것","오크라 하우스에 정식 초기 시들음병 약제 관주 처리로 정상적인 뿌리 내림 및 병해 사전 차단이 필요함","진딧물은 발견 즉시 방제로 확산을 막고 피해를 줄일 수 있음","인근 농가에 발생한 오크라 토마토반점위조바이러스 발생 포장은 하우스에 바이러스가 만연되어 있으므로 총채벌레 방제를 철저히 하고, 다시 정식하여 적용약제 처리로 바이러스가 발생하지 않도록 함","* 총채벌레에 등록된 적용약제가 없으므로 유기농자재를 사용하여 밀도를 줄여 피해가 생기지 않도록 할 것","논에 설치한 비닐하우스의 과습 피해는 하우스 주변을 깊게 고랑을 만들어 강우 시 빗물이 빠르게 배수되도록 하여 하우스 안으로 스며들지 않도록 할 것","관수 시설의 미비로 비닐하우스 내 토양 수분 관리가 어려우나 고랑 관개나 낮은 스프링클러를 이용하여 토양이 건조하거나 과습되지 않도록 관리를 철저히 해 줄 것","압력 보상형 점적테이프를 설치하기 전 유선(1544-8572)으로 협의 후 설치할 것을 당부함"]]],"omitted":0},{"no":"269213","title":"아열대채소(롱빈, 오크라) 현장 기술지원","crop":"오크라","region":"전남광주통합특별시 함평군","date":"2026-07-23","sections":[["영농현황",["재배작물: 롱빈, 고수, 오크라 등"]],["농가 및 현장 의견",["아열대채소 작물 병해충 방제방법 및 토양관리 등에 대한 현장 기술지원 요청"]],["현장 조사 결과",["롱빈 재배포장에 흰가루병, 진딧물 발생이 많았음","롱빈, 오크라를 재배하고 있는 시설 토양 수분은 38.8∼46.0%, EC 2.3∼2.7 dS/m, 토양온도 24.3∼24.6℃, 작토심 깊이는 18∼22㎝이었음","토양 pH 7.2∼7.3, 토양 중 질산이온 100㎎/㎏(적정), 인산이온 25㎎/㎏(부족)이었음"]],["종합 검토의견",["시설하우스의 다습한 환경조건, 환기 부족, 질소질 비료 과다 시용 등으로 인하여 흰가루병과 진딧물 발생이 많이 생긴 것으로 보임","논에 시설하우스를 설치하여 유효토심이 매우 낮고, 배수가 불량하고 수분이 많은 상태임"]],["기술지도 방향",["진딧물, 담배가루이, 나방류 발생 시에는 친환경 농약이나 두류에 등록된 적용 농약을 7일 간격으로, 계통을 다른 것으로 3회 번갈아 가면서 살포해 줄 것","금후 다습한 시기에 발생되는 점무늬낙엽병, 세균성갈색점무늬병 등은 환기, 통풍조절을 적정상태로 유지시켜 주고, 과습한 상태가 되지 않도록 관리해 줄 것","하우스 주변 배수로를 정비하여 강우 시 빗물이 유입되지 않고 빠르게 배수되도록 할 것","오크라는 수분요구도가 보통 수준이고, 뿌리는 직근성(1.0∼1.5m)이며, 측근이 60∼90㎝ 범위에 분포하고, 내습성에 약하므로 토양물리성 개선이 매우 중요함","토양 pH가 더 이상 높아지지 않도록 관리하기 위해 석회고토 사용을 자제하고, 질소질 비료는 황산암모늄(유안), 인산질 비료는 과린산석회, 칼리질 비료는 황산칼륨을 사용할 것","현재 웃거름으로 사용하고 있는 복합비료(콤미솔, 30-10-10+미량원소) 대신 질소보다 칼리 성분량이 많은 11-11-33을 추천함","매년 작물 파종 전에 붕사를 200평 기준 1㎏을 시비할 것","유효토심 깊이를 개선하기 위해 2년마다 경반층 파쇄기를 이용하여 심경(50㎝ 이상)할 것"]]],"omitted":0}]},"uses":{"crop":{"kinds":["채소"],"crops":["오크라"],"source":"농촌진흥청 국가농작물병해충관리시스템(NCPMS)","url":"https://ncpms.rda.go.kr"},"mfds":{"items":[{"name":"오크라","other":"Okra, Abelmoschus esculentus","sci":"Hibiscus esculentus L. / Abelmoschus esculentus (L.) Moench.","edible":"가능","parts":"뿌리, 잎, 꽃, 열매, 씨앗","cond":"","herbal":"","exact":false}],"source":"식품의약품안전처 수입식품 원료정보 (공공데이터포털)","url":"https://www.data.go.kr/data/15111777/openapi.do","retrieved":"2026-11-08"},"nutri":{"items":[{"name":"오크라, 생것","group":"채소류","year":"20","origin":"JAPAN","values":[["열량","26.0","㎉"],["수분","90.2","g"],["단백질","2.1","g"],["지방","0.2","g"],["탄수화물","6.6","g"],["당류","1.9","g"],["식이섬유","5.0","g"],["칼슘","92.0","㎎"],["철","0.5","㎎"],["칼륨","260.0","㎎"],["나트륨","4.0","㎎"],["비타민 A","56.0","㎍"],["베타카로틴","670.0","㎍"],["비타민 C","11.0","㎎"],["비타민 E","1.2","㎎"],["엽산","110.0","㎍"],["비타민 K","71.0","㎍"]]}],"source":"농촌진흥청 국립식량과학원 국가표준식품성분 DB 10.4 (공공데이터포털)","url":"https://www.data.go.kr/data/15143598/openapi.do","license":"공공누리 제4유형 (출처표시, 상업적 이용금지, 변경금지)","retrieved":"2026-11-08"},"web":{"attracts":["벌"],"edible":["꽃","열매"],"source":"NC State Extension Gardener Plant Toolbox (미국 노스캐롤라이나 주립대)","url":"https://plants.ces.ncsu.edu/plants/abelmoschus-esculentus/","retrieved":"2026-11-08"}}}