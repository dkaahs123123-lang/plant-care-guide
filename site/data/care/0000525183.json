,["알맞은 흙","점토(찰흙)"],["흙의 산도","산성 (pH 6.0 미만)"],["관리 난이도","높음"],["자라는 속도","빠름"],["한해·여러해살이","두해살이"],["번식 방법","씨앗"],["견디는 추위","약 -29°C까지 (USDA 5a 구역, 야외 기준)"],["다 자란 높이","약 1.5~2.4m"],["심을 자리 폭","약 30cm~0.9m"]],"notes":[["잘 견디는 것","흑호두나무 독성(주글론)"],["원산지","튀르키예, 서아시아"],["잘 생기는 해충","민달팽이·달팽이"]],"zone":"5a","zoneC":-28.9},"uses":{"web":{"attracts":["벌"],"edible":["꽃"],"source":"NC State Extension Gardener Plant Toolbox (미국 노스캐롤라이나 주립대)","url":"https://plants.ces.ncsu.edu/plants/alcea-rosea/","retrieved":"2026-11-02"}}}