ame=932ee8ec273f535d9bfef5afec965287a453c302c49a17a7c890e9c4757c7ecdaacb3649d110ce241a37c2dabd22f4e3fe234dbb9b0b97e48b03b12ae0114e5d","흰가루병 병징_10(잎) · 병증상"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=e206306d8f4e31fa10e0edebcebaf6a4eaebe819bfed7a1f6d6c115444382f0cafb7944232b44fee0c19265aaf5ffbedaf0f5f0dec207183e1b6e8d652a0abf502c32c9a2b851aaac9a28c4e2ec07211","보리 흰가루병 잎 피해증상1(잎)"]],24],["병원체 사진",[["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/pthgogan/&imageFileName=2e79f833675d10d996965488e93951d986d03971571f5c2c33d997d5dd027bbf2951089a4f6a8056b257206b422dbe2cf8fd6eec2b488d7bb904251fe46ceb25","보리 흰가루병 분생포자"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/pthgogan/&imageFileName=2e79f833675d10d996965488e93951d9ce01ffad9f308229a7b36a7656c65635e01f75bcc29811385ecfbcd69b998c078164df04f379c4cfbb086b9c81afe04c","보리 흰가루병 분생포자경_1"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/pthgogan/&imageFileName=2e79f833675d10d996965488e93951d9ce01ffad9f308229a7b36a7656c65635e629d055373d8deae2504ed7f462149ec462b80979a9e47094e3cc6d4b673a61","보리 흰가루병 분생포자경_2"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/pthgogan/&imageFileName=2e79f833675d10d996965488e93951d9ce01ffad9f308229a7b36a7656c65635d1685015490ef0a0fc3d32b1e5494da9b963208d22fb86cad603347595520518","보리 흰가루병 분생포자경_3"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/pthgogan/&imageFileName=932ee8ec273f535d9bfef5afec9652879b0d59a2e926e8180155ff7e53b05351457bf1c5c6ed71b6115908d977ce3bd7f8fd6eec2b488d7bb904251fe46ceb25","보리 흰가루병 병징 확대_1"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/pthgogan/&imageFileName=932ee8ec273f535d9bfef5afec965287fed911525ca0e2655530df1fca96d7c9796038fb2a16a91f77fc958787b8c906f8fd6eec2b488d7bb904251fe46ceb25","보리 흰가루병 병징 확대_2"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/pthgogan/&imageFileName=932ee8ec273f535d9bfef5afec9652870374ba17d74e0d984fca6558551bd14615b7536b821d25a29600b94392622168f8fd6eec2b488d7bb904251fe46ceb25","보리 흰가루병 병징 확대_3"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/pthgogan/&imageFileName=932ee8ec273f535d9bfef5afec965287c9fd738f9e5ae4757accf29597bf8586f0d137d31b0ad7a850723bf058fb75d0f8fd6eec2b488d7bb904251fe46ceb25","보리 흰가루병 병징 확대_4"]],8]]}],"insects":[{"crop":"보리","name":"기장테두리진딧물","sci":"Rhopalosiphum padi","family":"진딧물과","damage":"벼과 식물을 중간 기주로 이용하며,특히 보리에 대발생하여 잎에 군집을 이루며, 이삭에도 기생한다.\n피해를 받으면 보리의 생육이 뚜렷하게 저해된다.옥수수에서도 잎이나 줄기에 많이 발생하며, 때로는 열매나 이삭에도 기생하여 가해한다.","form":"무시충의 몸길이는 1.2~2.4mm, 암녹색, 연녹색 또는 녹색을 띠며 뿔관 아래 부분에 붉은 반점이 있다. 무시충과 무시형 약충은 표면에 흰 밀랍가루를 얇게 쓰고 있고, 유시형 약충은 복부 양측의 밀랍가루가 두터운 띠를 형성하고 있다.","ecology":"보리의 해충으로 유명한 종이며,옥수수, 밀, 귀리, 파파야, 벼, 수수, 단수수도 가해한다.\n벚나무, 사과 등을 겨울 기주로 삼아 알로 월동한다.\n따뜻한 곳에서는 암컷 성충 또는 약충으로 월동한다.\n약충 발육기간은 21℃에서 15~19일이다.\n출산은 약70개까지 한다.6월에 최고 발생을 보인 후 6월 말부터 7월 초에 밀도는 급격히 줄어든다.\n예찰은 이 진딧물은 전체적으로 검은색을 띠어 초록색을 많이 띠는 보리두갈래 진딧물과 구분할 수 있다.","prevention":"발생이 심한 경우 등록된 전용약제를 살포하여 방제한다.","chemical":"","biology":"","distrib":"","photos":[["피해 사진",[["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=10f3ab5ea94e43cc916ce8ff9c5d92124a1013ce3444c8f81e25e8e574d71a191f948b39d24e1a0546cc93445ef6c86526ef395bd9d57c52b66f3bfaffcf5583a1b04ada6e1c0b93661ee20ded58d684fffb74c6440ff0e374a99cbf74b9c9de7efd93b7a9f55405a39547bd828786fffe234dbb9b0b97e48b03b12ae0114e5d","기장테두리진딧물 성충"],["https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=6f4e7ea9b8a4167fdcf4b7daedc37ceb4a1013ce3444c8f81e25e8e574d71a191f948b39d24e1a0546cc93445ef6c86526ef395bd9d57c52b66f3bfaf